{
  "name": "csv2json-mini",
  "version": "0.1.1",
  "description": "Tiny dependency-free CSV to JSON converter with a CLI.",
  "license": "MIT",
  "author": "acus9345 <acus9345@gmail.com>",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "csv2json-mini": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"test/**/*.test.js\"",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acus9345/csv2json-mini.git"
  },
  "homepage": "https://github.com/acus9345/csv2json-mini#readme",
  "bugs": {
    "url": "https://github.com/acus9345/csv2json-mini/issues"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  },
  "private": true
}
